// =====================================================
// DOSE NAMES
// =====================================================

String getDoseName(int dose)
{
  if (dose == 0)
    return "Morning Medicine";

  if (dose == 1)
    return "Afternoon Medicine";

  if (dose == 2)
    return "Night Medicine";

  return "Unknown";
}


// =====================================================
// DOSE TIME
// =====================================================

String getDoseTime(int dose)
{
  char buffer[10];

  int hour = 0;
  int minute = 0;

  if (dose == 0)
  {
    hour = morningHour;
    minute = morningMinute;
  }
  else if (dose == 1)
  {
    hour = afternoonHour;
    minute = afternoonMinute;
  }
  else if (dose == 2)
  {
    hour = nightHour;
    minute = nightMinute;
  }

  sprintf(
    buffer,
    "%02d:%02d",
    hour,
    minute
  );

  return String(buffer);
}


// =====================================================
// DOSE NUMBER FOR THINGSPEAK
// =====================================================

int getDoseNumber()
{
  if (activeDose == 0)
    return 1;

  if (activeDose == 1)
    return 2;

  if (activeDose == 2)
    return 3;

  return 0;
}


// =====================================================
// DOSE SCHEDULE CHECK
// =====================================================

int getCurrentDose(DateTime now)
{
  int currentMinutes =
    now.hour() * 60 + now.minute();

  int morning =
    morningHour * 60 + morningMinute;

  int afternoon =
    afternoonHour * 60 + afternoonMinute;

  int night =
    nightHour * 60 + nightMinute;


  if (currentMinutes == morning)
    return 0;

  if (currentMinutes == afternoon)
    return 1;

  if (currentMinutes == night)
    return 2;

  return -1;
}


// =====================================================
// OLED MESSAGE
// =====================================================

void showMessage(
  String line1,
  String line2 = "",
  String line3 = ""
)
{
  u8g2.clearBuffer();

  u8g2.setFont(
    u8g2_font_6x12_tf
  );

  u8g2.drawStr(
    0,
    14,
    line1.c_str()
  );

  if (line2 != "")
  {
    u8g2.drawStr(
      0,
      32,
      line2.c_str()
    );
  }

  if (line3 != "")
  {
    u8g2.drawStr(
      0,
      50,
      line3.c_str()
    );
  }

  u8g2.sendBuffer();
}


