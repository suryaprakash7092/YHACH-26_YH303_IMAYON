    115200
  );


  delay(1000);


  Serial.println();

  Serial.println(
    "================================"
  );

  Serial.println(
    "DOSEGUARD AI"
  );

  Serial.println(
    "IoT Medication System"
  );

  Serial.println(
    "Firebase + ThingSpeak"
  );

  Serial.println(
    "Caretaker Alert System"
  );

  Serial.println(
    "================================"
  );


  // ---------------------------------------------------
  // PINS
  // ---------------------------------------------------

  pinMode(
    MC38_PIN,
    INPUT_PULLUP
  );


  pinMode(
    BUZZER_PIN,
    OUTPUT
  );


  pinMode(
    LED_PIN,
    OUTPUT
  );


  digitalWrite(
    BUZZER_PIN,
    LOW
  );


  digitalWrite(
    LED_PIN,
    LOW
  );


  // ---------------------------------------------------
  // OLED
  // ---------------------------------------------------

  u8g2.begin();


