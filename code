  // RTC
  // ---------------------------------------------------

  if (!rtc.begin())
  {
    Serial.println(
      "RTC NOT FOUND!"
    );


    showMessage(
      "RTC ERROR",
      "Check DS3231"
    );


    while (1)
    {
      delay(100);
    }
  }


  Serial.println(
    "RTC OK"
  );


  // ---------------------------------------------------
  // WIFI
  // ---------------------------------------------------

  connectWiFi();


  // ---------------------------------------------------
  // FIREBASE
  // ---------------------------------------------------

  ssl_client.setInsecure();


  setupFirebase();


  // ---------------------------------------------------
  // INITIAL THINGSPEAK STATUS
  // ---------------------------------------------------

  thingSpeakDoseStatus = 0;


  // ---------------------------------------------------
  // INITIAL THINGSPEAK UPLOAD
  // ---------------------------------------------------

  delay(2000);

  sendThingSpeakData();


  lastThingSpeakUpload =
    millis();


  // ---------------------------------------------------
  // INITIAL SCREEN
  // ---------------------------------------------------

  showMessage(
    "SYSTEM READY",
    "Cloud Connected",
    "Firebase + ThingSpeak"
  );


  delay(2000);


  Serial.println(
    "SYSTEM READY"
  );
}


// =====================================================
// LOOP
// =====================================================

void loop()
{
  // ---------------------------------------------------
  // FIREBASE BACKGROUND PROCESSING
  // ---------------------------------------------------

  app.loop();


  // ---------------------------------------------------
  // GET RTC TIME
  // ---------------------------------------------------

  DateTime now =
    rtc.now();


  // ---------------------------------------------------
  // FIREBASE DEVICE STATUS
  // EVERY 10 SECONDS
  // ---------------------------------------------------

  static unsigned long lastStatusUpload = 0;


  if (
    app.ready() &&
    millis() -
    lastStatusUpload >=
    10000
  )
  {
    lastStatusUpload =
      millis();


    sendDeviceStatus();


    Serial.println(
      "Firebase status updated"
    );
  }


  // ---------------------------------------------------
  // THINGSPEAK
  // EVERY 15 SECONDS
  // ---------------------------------------------------

  if (
    millis() -
    lastThingSpeakUpload >=
    THINGSPEAK_INTERVAL
  )
  {
    lastThingSpeakUpload =
      millis();


    sendThingSpeakData();
  }


  // ---------------------------------------------------
  // CHECK DOSE SCHEDULE
  // ---------------------------------------------------

  int scheduledDose =
    getCurrentDose(now);


  // ---------------------------------------------------
  // START NEW DOSE
  // ---------------------------------------------------

  if (
    scheduledDose != -1 &&
    !doseActive &&
    !doseHandled
  )
  {
    // Prevent starting same dose repeatedly

    if (
      lastFirebaseMinute !=
      now.minute() ||

      lastFirebaseDay !=
      now.day()
    )
    {
      lastFirebaseMinute =
        now.minute();

      lastFirebaseDay =
        now.day();


      startDose(
        scheduledDose,
        now
      );
    }
  }


  // ---------------------------------------------------
  // RESET DAILY DOSE LOCK
  // ---------------------------------------------------

  if (
    now.minute() !=
    lastFirebaseMinute &&

    !doseActive
  )
  {
    doseHandled = false;
    doseMissed = false;

    patientReminderSent = false;
    caretakerAlertSent = false;


    // Return ThingSpeak status to IDLE

    if (
      thingSpeakDoseStatus == 2 ||
      thingSpeakDoseStatus == 3
    )
    {
      thingSpeakDoseStatus = 0;
    }
  }


  // ---------------------------------------------------
  // CHECK ACTIVE DOSE
  // ---------------------------------------------------

  checkDoseAccess(now);


  // ---------------------------------------------------
  // MAIN OLED
  // ---------------------------------------------------

  static unsigned long lastDisplayUpdate = 0;


  if (
    millis() -
    lastDisplayUpdate >=
    1000
  )
  {
    lastDisplayUpdate =
      millis();


    if (!doseActive)
    {
      showMainScreen(now);
    }
  }


  delay(10);
}
