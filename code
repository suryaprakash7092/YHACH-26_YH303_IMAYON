// ===============================
// OLED - 1.3" SH1106 128x64
// ===============================
U8G2_SH1106_128X64_NONAME_F_HW_I2C u8g2(
  U8G2_R0,
  U8X8_PIN_NONE,
  22,   // SCL
  21    // SDA
);

// ===============================
// RTC
// ===============================
RTC_DS3231 rtc;

// ===============================
// WIFI
// ===============================
const char* WIFI_SSID = "arun's A16";
const char* WIFI_PASSWORD = "123456@@";

// India Standard Time
const long GMT_OFFSET_SEC = 19800;
const int DAYLIGHT_OFFSET_SEC = 0;

// ===============================
// PINS
// ===============================
#define MC38_PIN     32
#define BUZZER_PIN   25
#define LED_PIN      26

// ===============================
// DOSE TIMES
// ===============================
const int MORNING_HOUR   = 8;
const int MORNING_MINUTE = 0;

const int AFTERNOON_HOUR   = 13;
const int AFTERNOON_MINUTE = 0;

const int NIGHT_HOUR   = 21;
const int NIGHT_MINUTE = 35;

// ===============================
// SETTINGS
// ===============================

// TEST: 2 minutes
// Later change 2 to 5, 10, 30 etc.
const unsigned long DOSE_WINDOW =
  2UL * 60UL * 1000UL;

// Buzzer duration
const unsigned long BUZZER_TIME =
  10UL * 1000UL;

// ===============================
// VARIABLES
// ===============================
bool doseActive = false;
bool doseAccessed = false;
bool doseMissed = false;

unsigned long doseStartTime = 0;
unsigned long buzzerStartTime = 0;

int activeDoseHour = -1;
int activeDoseMinute = -1;

String activeDoseName = "";

int lastProcessedMinute = -1;

bool timeSynced = false;

// ===============================
// SETUP
// ===============================
void setup() {

  Serial.begin(115200);

  // I2C
  Wire.begin(21, 22);

  // Pins
  pinMode(MC38_PIN, INPUT_PULLUP);
  pinMode(BUZZER_PIN, OUTPUT);
  pinMode(LED_PIN, OUTPUT);

  digitalWrite(BUZZER_PIN, LOW);
  digitalWrite(LED_PIN, LOW);

  // OLED
  u8g2.begin();

  showStartingScreen();

  // RTC
  if (!rtc.begin()) {

    showMessage(
      "RTC ERROR",
      "Check DS3231"
    );

    Serial.println("RTC NOT FOUND!");

    while (1);
  }

  Serial.println("RTC OK");

  // ===============================
  // CONNECT WIFI
  // ===============================
  connectWiFi();

  // ===============================
  // GET INTERNET TIME
  // ===============================
  if (WiFi.status() == WL_CONNECTED) {

    syncRTCFromNTP();
  }

  showReadyScreen();

  Serial.println("======================");
  Serial.println("DOSEGUARD AI READY");
  Serial.println("======================");
}

// ===============================
// MAIN LOOP
// ===============================
void loop() {

  // Keep Wi-Fi connected
  if (WiFi.status() != WL_CONNECTED) {

    Serial.println("WiFi disconnected.");

    connectWiFi();
  }

  // Get RTC time
  DateTime now = rtc.now();

  int currentHour = now.hour();
  int currentMinute = now.minute();

  // ===============================
  // CHECK NEW DOSE
  // ===============================
  if (currentMinute != lastProcessedMinute) {

    lastProcessedMinute = currentMinute;

    checkDoseSchedule(
      currentHour,
      currentMinute
    );
  }

  // ===============================
  // ACTIVE DOSE
  // ===============================
  if (doseActive) {

    bool compartmentOpen =
      isCompartmentOpen();

    // ===============================
    // DOSE ACCESSED
    // ===============================
    if (compartmentOpen && !doseAccessed) {

      doseAccessed = true;
      doseActive = false;

      digitalWrite(BUZZER_PIN, LOW);
      digitalWrite(LED_PIN, LOW);

      showAccessedScreen();

      Serial.println("DOSE ACCESSED");

      delay(3000);
    }

    // ===============================
    // STOP BUZZER
    // ===============================
    if (millis() - buzzerStartTime >=
        BUZZER_TIME) {

      digitalWrite(BUZZER_PIN, LOW);
      digitalWrite(LED_PIN, LOW);
    }

    // ===============================
    // MISSED DOSE
    // ===============================
    if (!doseAccessed &&
        millis() - doseStartTime >=
        DOSE_WINDOW) {

      doseActive = false;
      doseMissed = true;

      digitalWrite(BUZZER_PIN, LOW);
      digitalWrite(LED_PIN, LOW);

      showMissedScreen();

      Serial.println("======================");
      Serial.println("MISSED DOSE");
      Serial.println("Caretaker alert needed");
      Serial.println("======================");

      delay(3000);
    }
  }

  // ===============================
  // NORMAL SCREEN
  // ===============================
  if (!doseActive &&
      !doseMissed &&
      !doseAccessed) {

    showMainScreen(now);
  }

  delay(200);
}

// ===============================
// WIFI CONNECTION
// ===============================
void connectWiFi() {

  Serial.println();
  Serial.print("Connecting to WiFi: ");
  Serial.println(WIFI_SSID);

  u8g2.clearBuffer();

  u8g2.setFont(u8g2_font_ncenB12_tr);
  u8g2.drawStr(20, 20, "WiFi");

  u8g2.setFont(u8g2_font_6x10_tf);
  u8g2.drawStr(15, 40, "CONNECTING...");

  u8g2.sendBuffer();

  WiFi.begin(
    WIFI_SSID,
    WIFI_PASSWORD
  );

  int attempts = 0;

  while (WiFi.status() != WL_CONNECTED &&
         attempts < 20) {

    delay(500);

    Serial.print(".");

    attempts++;
  }

  Serial.println();

  if (WiFi.status() == WL_CONNECTED) {

    Serial.println("WiFi CONNECTED!");

    Serial.print("IP Address: ");
    Serial.println(WiFi.localIP());

    showMessage(
      "WiFi CONNECTED",
      "IP READY"
    );

    delay(1500);
  }

  else {

    Serial.println("WiFi FAILED");

    showMessage(
      "WiFi OFFLINE",
      "RTC ACTIVE"
    );

    delay(1500);
  }
}

// ===============================
// NTP → RTC
// ===============================
void syncRTCFromNTP() {

  Serial.println("Getting NTP time...");

  configTime(
    GMT_OFFSET_SEC,
    DAYLIGHT_OFFSET_SEC,
    "pool.ntp.org",
    "time.nist.gov"
  );

  struct tm timeinfo;

  if (!getLocalTime(
        &timeinfo,
        10000)) {

    Serial.println(
      "NTP TIME FAILED"
    );

    timeSynced = false;

    return;
  }

  // Convert NTP time to DateTime
  DateTime ntpTime(
    timeinfo.tm_year + 1900,
    timeinfo.tm_mon + 1,
    timeinfo.tm_mday,
    timeinfo.tm_hour,
    timeinfo.tm_min,
    timeinfo.tm_sec
  );

  // Set DS3231
  rtc.adjust(ntpTime);

  timeSynced = true;

  Serial.println(
    "RTC synchronized from NTP!"
  );

  Serial.print("Date: ");
  Serial.print(ntpTime.day());
  Serial.print("/");
  Serial.print(ntpTime.month());
  Serial.print("/");
  Serial.println(ntpTime.year());

  Serial.print("Time: ");
  Serial.print(ntpTime.hour());
  Serial.print(":");
  Serial.print(ntpTime.minute());
  Serial.print(":");
  Serial.println(ntpTime.second());
}

// ===============================
// DOSE SCHEDULE
// ===============================
void checkDoseSchedule(
  int hour,
  int minute
) {

  if (hour == MORNING_HOUR &&
      minute == MORNING_MINUTE) {

    startDose(
      MORNING_HOUR,
      MORNING_MINUTE,
      "MORNING"
    );
  }

  else if (
    hour == AFTERNOON_HOUR &&
    minute == AFTERNOON_MINUTE
  ) {

    startDose(
      AFTERNOON_HOUR,
      AFTERNOON_MINUTE,
      "AFTERNOON"
    );
  }

  else if (
    hour == NIGHT_HOUR &&
    minute == NIGHT_MINUTE
  ) {

    startDose(
      NIGHT_HOUR,
      NIGHT_MINUTE,
      "NIGHT"
    );
  }
}

// ===============================
// START DOSE
// ===============================
void startDose(
  int hour,
  int minute,
  String name
) {

  doseActive = true;
  doseAccessed = false;
  doseMissed = false;

  activeDoseHour = hour;
  activeDoseMinute = minute;
  activeDoseName = name;

  doseStartTime = millis();
  buzzerStartTime = millis();

  digitalWrite(
    BUZZER_PIN,
    HIGH
  );

  digitalWrite(
    LED_PIN,
    HIGH
  );

  showReminderScreen();

  Serial.println();
  Serial.println("======================");
  Serial.print("DOSE REMINDER: ");
  Serial.println(name);
  Serial.println("======================");
}

// ===============================
// MC-38
// ===============================
bool isCompartmentOpen() {

  // LOW  = CLOSED
  // HIGH = OPEN

  return digitalRead(MC38_PIN) == HIGH;
}

// ===============================
// MAIN SCREEN
// ===============================
void showMainScreen(
  DateTime now
) {

  char timeBuffer[10];

  sprintf(
    timeBuffer,
    "%02d:%02d:%02d",
    now.hour(),
    now.minute(),
    now.second()
  );

  u8g2.clearBuffer();

  u8g2.setFont(
    u8g2_font_ncenB12_tr
  );

  u8g2.drawStr(
    5,
    15,
    "DOSEGUARD AI"
  );

  u8g2.setFont(
    u8g2_font_ncenB14_tr
  );

  u8g2.drawStr(
    25,
    38,
    timeBuffer
  );

  u8g2.setFont(
    u8g2_font_6x10_tf
  );

  if (isCompartmentOpen()) {

    u8g2.drawStr(
      5,
      53,
      "COMPARTMENT: OPEN"
    );
  }

  else {

    u8g2.drawStr(
      5,
      53,
      "COMPARTMENT: CLOSED"
    );
  }

  // WiFi status
  if (WiFi.status() ==
      WL_CONNECTED) {

    u8g2.drawStr(
      105,
      63,
      "W"
    );
  }

  else {

    u8g2.drawStr(
      105,
      63,
      "-"
    );
  }

  u8g2.sendBuffer();
}

