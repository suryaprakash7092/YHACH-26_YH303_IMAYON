// =====================================================
// START DOSE
// =====================================================

void startDose(
  int dose,
  DateTime now
)
{
  activeDose = dose;

  doseActive = true;
  doseHandled = false;
  doseMissed = false;

  // Reset alert flags for new dose
  patientReminderSent = false;
  caretakerAlertSent = false;


  doseStartMillis =
    millis();

  buzzerStartMillis =
    millis();


  // ThingSpeak status
  thingSpeakDoseStatus = 1;


  // Turn buzzer ON
  digitalWrite(
    BUZZER_PIN,
    HIGH
  );


  // Turn LED ON
  digitalWrite(
    LED_PIN,
    HIGH
  );


  String doseName =
    getDoseName(dose);


  showMessage(
    "MEDICINE TIME",
    doseName,
    "OPEN COMPARTMENT"
  );


  // Firebase
  sendCurrentDose(
    dose,
    "WAITING"
  );


  Serial.println();
  Serial.println(
    "================================"
  );

  Serial.println(
    "MEDICINE TIME"
  );

  Serial.println(
    doseName
  );

  Serial.println(
    "Patient has 30 minutes"
  );

  Serial.println(
    "Caretaker alert after 10 minutes"
  );

  Serial.println(
    "================================"
  );


  // ThingSpeak
  sendThingSpeakData();
}


// =====================================================
// CHECK ACTIVE DOSE
// =====================================================

void checkDoseAccess(DateTime now)
{
  if (!doseActive)
    return;


  unsigned long elapsedTime =
    millis() - doseStartMillis;


  // ---------------------------------------------------
  // CHECK COMPARTMENT
  // ---------------------------------------------------

  bool compartmentOpen =
    digitalRead(MC38_PIN) == HIGH;


  // ---------------------------------------------------
  // USER OPENED COMPARTMENT
  // ---------------------------------------------------

  if (
    compartmentOpen &&
    !doseHandled
  )
  {
    doseAccessed(now);

    return;
  }


  // ---------------------------------------------------
  // STOP INITIAL BUZZER AFTER 10 SECONDS
  // ---------------------------------------------------

  if (
    millis() -
    buzzerStartMillis >=
    BUZZER_TIME
  )
  {
    digitalWrite(
      BUZZER_PIN,
      LOW
    );
  }


  // ---------------------------------------------------
  // PATIENT REMINDER AFTER 5 MINUTES
  // ---------------------------------------------------

  if (
    elapsedTime >=
    PATIENT_REMINDER_TIME &&

    !patientReminderSent
  )
  {
    patientReminderSent = true;


    String doseName =
      getDoseName(activeDose);


    Serial.println();
    Serial.println(
      "--------------------------------"
    );

    Serial.println(
      "PATIENT REMINDER"
    );

    Serial.println(
      "Medicine still not taken"
    );

    Serial.println(
      doseName
    );

    Serial.println(
      "--------------------------------"
    );


    // OLED
    showMessage(
      "REMINDER",
      "TAKE MEDICINE",
      doseName
    );


    // Short reminder buzzer
    digitalWrite(
      BUZZER_PIN,
      HIGH
    );

    digitalWrite(
      LED_PIN,
      HIGH
    );


    buzzerStartMillis =
      millis();


    // Firebase
    sendCurrentDose(
      activeDose,
      "REMINDER"
    );


    // History
    sendHistoryEvent(
      now,
      doseName,
      "PATIENT REMINDER"
    );
  }


  // ---------------------------------------------------
  // CARETAKER ALERT AFTER 10 MINUTES
  // ---------------------------------------------------

  if (
    elapsedTime >=
    CARETAKER_ALERT_TIME &&

    !caretakerAlertSent
  )
  {
    caretakerAlertSent = true;


    Serial.println();
    Serial.println(
      "################################"
    );

    Serial.println(
      "CARETAKER ALERT TRIGGERED"
    );

    Serial.println(
      "Patient has NOT taken medicine"
    );

    Serial.println(
      "Sending to Firebase..."
    );

    Serial.println(
      "################################"
    );


    // Send caretaker alert
    sendCaretakerAlert(now);


    // Keep dose status WAITING
    thingSpeakDoseStatus = 1;


    // Upload to ThingSpeak
    sendThingSpeakData();


    // OLED
    showMessage(
      "CARETAKER ALERT",
      "NOT TAKEN",
      "ALERT SENT"
    );
  }


  // ---------------------------------------------------
  // MISSED AFTER 30 MINUTES
  // ---------------------------------------------------

  if (
    elapsedTime >=
    DOSE_WINDOW
  )
  {
    missedDose(now);

    return;
  }
}


