// =====================================================
// THINGSPEAK UPLOAD
// =====================================================

void sendThingSpeakData()
{
  if (WiFi.status() != WL_CONNECTED)
  {
    Serial.println(
      "ThingSpeak: WiFi not connected"
    );

    return;
  }


  // ---------------------------------------------------
  // MC-38 STATUS
  // ---------------------------------------------------

  int mc38Status = 0;

  if (
    digitalRead(MC38_PIN) == HIGH
  )
  {
    mc38Status = 1;
  }
  else
  {
    mc38Status = 0;
  }


  // ---------------------------------------------------
  // DOSE NUMBER
  // ---------------------------------------------------

  int doseNumber =
    getDoseNumber();


  // ---------------------------------------------------
  // MISSED DOSE
  // ---------------------------------------------------

  int missed =
    doseMissed ? 1 : 0;


  // ---------------------------------------------------
  // WIFI RSSI
  // ---------------------------------------------------

  int rssi =
    WiFi.RSSI();


  // ---------------------------------------------------
  // CONNECT THINGSPEAK
  // ---------------------------------------------------

  Serial.println();
  Serial.println(
    "Uploading to ThingSpeak..."
  );


  if (
    !thingSpeakClient.connect(
      THINGSPEAK_HOST,
      80
    )
  )
  {
    Serial.println(
      "ThingSpeak connection failed"
    );

    return;
  }


  // ---------------------------------------------------
  // BUILD REQUEST
  // ---------------------------------------------------

  String url =
    "/update?api_key=" +
    String(THINGSPEAK_API_KEY) +

    "&field1=" +
    String(mc38Status) +

    "&field2=" +
    String(thingSpeakDoseStatus) +

    "&field3=" +
    String(doseNumber) +

    "&field4=" +
    String(missed) +

    "&field5=" +
    String(accessCount) +

    "&field6=" +
    String(rssi);


  // ---------------------------------------------------
  // HTTP GET
  // ---------------------------------------------------

  thingSpeakClient.print(
    String("GET ") +
    url +
    " HTTP/1.1\r\n" +

    "Host: " +
    THINGSPEAK_HOST +
    "\r\n" +

    "Connection: close\r\n\r\n"
  );


  // ---------------------------------------------------
  // READ RESPONSE
  // ---------------------------------------------------

  unsigned long timeout =
    millis();

  while (
    thingSpeakClient.available() == 0
  )
  {
    if (
      millis() - timeout > 5000
    )
    {
      Serial.println(
        "ThingSpeak timeout"
      );

      thingSpeakClient.stop();

      return;
    }

    delay(10);
  }


  String response =
    thingSpeakClient.readString();

  thingSpeakClient.stop();


  Serial.println(
    "ThingSpeak response:"
  );

  Serial.println(response);


  // ---------------------------------------------------
  // SUCCESS
  // ---------------------------------------------------

  if (
    response.indexOf("200 OK") >= 0
  )
  {
    Serial.println(
      "ThingSpeak upload successful!"
    );
  }
  else
  {
    Serial.println(
      "ThingSpeak upload completed"
    );
  }


  Serial.println(
    "--------------------------------"
  );

  Serial.print(
    "MC-38: "
  );

  Serial.println(
    mc38Status
  );

  Serial.print(
    "Dose Status: "
  );

  Serial.println(
    thingSpeakDoseStatus
  );

  Serial.print(
    "Dose Number: "
  );

  Serial.println(
    doseNumber
  );

  Serial.print(
    "Missed: "
  );

  Serial.println(
    missed
  );

  Serial.print(
    "Access Count: "
  );

  Serial.println(
    accessCount
  );

  Serial.print(
    "RSSI: "
  );

  Serial.println(
    rssi
  );
}


// =====================================================
// DOSE ACCESSED
// =====================================================

void doseAccessed(DateTime now)
{
  if (doseHandled)
    return;


  doseHandled = true;
  doseActive = false;


  // Reset alert flags
  patientReminderSent = false;
  caretakerAlertSent = false;


  // ThingSpeak status
  thingSpeakDoseStatus = 2;


  // Increase access count
  accessCount++;


  // Stop buzzer
  digitalWrite(
    BUZZER_PIN,
    LOW
  );


  // Stop LED
  digitalWrite(
    LED_PIN,
    LOW
  );


  String doseName =
    getDoseName(activeDose);


  showMessage(
    "DOSE ACCESS",
    "OK",
    "ACCESS RECORDED"
  );


  // Firebase current dose
  sendCurrentDose(
    activeDose,
    "ACCESSED"
  );


  // Firebase history
  sendHistoryEvent(
    now,
    doseName,
    "ACCESSED"
  );


  Serial.println();
  Serial.println(
    "================================"
  );

  Serial.println(
    "DOSE ACCESSED"
  );

  Serial.println(
    doseName
  );

  Serial.print(
    "Access Count: "
  );

  Serial.println(
    accessCount
  );

  Serial.println(
    "================================"
  );


  // ThingSpeak
  sendThingSpeakData();


  delay(2000);
}


